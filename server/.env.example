# =============================================================================
# ShopGuide Agent 后端配置示例
#
# 使用方式：
# 1. 复制本文件为 .env。
# 2. 默认配置已经可以本地跑 Demo：local 检索 + 本地兜底回答。
# 3. 标注“二选一”的配置块，只保留你实际使用的一组，避免后面的变量覆盖前面的变量。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 基础服务配置
# -----------------------------------------------------------------------------

# 后端 HTTP 服务端口。客户端 ApiConfig.BASE_URL 需要和这里保持一致。
PORT=3001

# 商品数据集目录。默认从 server 目录出发，读取项目根目录下的 ecommerce_agent_dataset。
DATASET_DIR=../ecommerce_agent_dataset


# -----------------------------------------------------------------------------
# 2. 向量库配置（二选一：local 或 qdrant）
# -----------------------------------------------------------------------------

# 当前启用：local
# local 不依赖外部服务，适合本地 Demo 和开发调试。
VECTOR_STORE=local

# 如需切换到 Qdrant：
# 1. 启动 docker-compose.yml 里的 Qdrant。
# 2. 把上面的 VECTOR_STORE=local 改成 VECTOR_STORE=qdrant。
# 3. 确认下面地址和 collection 名称正确。
# collection 名称建议跟 embedding 方案对应，而不是跟聊天模型对应：
# - EMBEDDING_PROVIDER=local / 384维：建议 QDRANT_COLLECTION=shopguide_products
# - EMBEDDING_PROVIDER=ark / 1024维：建议 QDRANT_COLLECTION=shopguide_products_ark
# 如果切换了 embedding 方案，需要换 collection 名称或清空旧 collection 后重新入库。
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=shopguide_products


# -----------------------------------------------------------------------------
# 3. Embedding 配置（二选一：local 或 ark）
# -----------------------------------------------------------------------------

# 当前启用：local
# local 是离线哈希向量，不需要 API Key；语义效果弱于真实 embedding。
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384

# 如需切换到 Ark embedding：
# 1. 把 EMBEDDING_PROVIDER=local 改成 EMBEDDING_PROVIDER=ark。
# 2. 把 EMBEDDING_DIMENSION 改为 1024。
# 3. 填写 ARK_EMBEDDING_API_KEY。Embedding 和聊天可以使用不同模型、不同 API Key。
# 如果 ARK_EMBEDDING_API_KEY 留空，后端会兼容性回退使用 ARK_API_KEY。
ARK_EMBEDDING_API_KEY=
ARK_EMBEDDING_MODEL=doubao-embedding-vision-250615
ARK_EMBEDDING_PATH=/embeddings/multimodal

# -----------------------------------------------------------------------------
# 4. 聊天大模型配置（二选一：ark 或 deepseek）
# -----------------------------------------------------------------------------

# 当前启用：ark
# 如果 ARK_API_KEY 为空，服务会使用本地规则兜底回答，Demo 仍可运行。
# ARK_API_KEY 是聊天模型 Key；ARK_EMBEDDING_API_KEY 是 embedding Key，两者可以不同。
# ARK_MODEL 是聊天模型 endpoint；ARK_EMBEDDING_MODEL 是 embedding 模型，两者也不是同一个配置。
LLM_PROVIDER=ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=ep-your-chat-endpoint

# 如需切换到 DeepSeek：
# 1. 注释掉上面4行的ark配置。
# 2. 取消下面 LLM_PROVIDER=deepseek 和 DEEPSEEK_API_KEY 的注释。
# 3. 填写你的 DeepSeek API Key。
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=你的 DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat


# -----------------------------------------------------------------------------
# 5. 热门查询缓存
# -----------------------------------------------------------------------------

# true 开启缓存；false 关闭缓存。
# 只缓存不依赖上下文的新搜索，例如“推荐适合油皮的防晒霜”。
# 不缓存“第二款怎么样”“比较2和3”等依赖当前会话的追问。
HOT_QUERY_CACHE_ENABLED=true

# 全服务最多缓存多少条热门新搜索，不是每个用户各 80 条。
HOT_QUERY_CACHE_MAX_ENTRIES=80

# 缓存有效期，单位毫秒。
# 600000 = 10 分钟；1800000 = 30 分钟；3600000 = 1 小时。
HOT_QUERY_CACHE_TTL_MS=600000


# -----------------------------------------------------------------------------
# 6. 会话记忆持久化
# -----------------------------------------------------------------------------

# true 开启持久化；false 时只保留进程内存。
# 开启后，后端重启仍能恢复 deviceId + conversationId 对应的多轮上下文。
SESSION_PERSISTENCE_ENABLED=true

# SQLite 数据库路径。默认写到 server/.data/，该目录是运行产物，不应提交到仓库。
SESSION_STORE_PATH=.data/shopguide_sessions.db
