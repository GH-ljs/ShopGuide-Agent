PORT=3001
DATASET_DIR=../ecommerce_agent_dataset

# 向量库。local 不依赖外部服务；qdrant 需要先启动 Docker/Qdrant。
VECTOR_STORE=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=shopguide_products

# Embedding。local 是离线哈希向量；ark 会调用 Doubao/Ark embedding API。
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
ARK_EMBEDDING_MODEL=doubao-embedding-vision-250615
ARK_EMBEDDING_PATH=/embeddings/multimodal

# 聊天大模型。如果对应 Key 为空，服务会使用本地规则兜底回答。
# LLM_PROVIDER 可选：ark、deepseek。下面选其一
# 豆包
LLM_PROVIDER=ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=ep-20260514111645-lmgt2
# deepseek
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=你的 DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
